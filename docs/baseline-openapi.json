  "components": {
    "schemas": {
      "CacheInfo": {
        "properties": {
          "hit": {
            "type": "boolean",
            "title": "Hit",
            "description": "Whether the response was served from cache."
          },
          "layer": {
            "type": "string",
            "title": "Layer",
            "description": "Cache layer: 'none', 'memory' or 'persistent'."
          },
          "age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Seconds",
            "description": "Age of the cached entry in seconds, when known."
          }
        },
        "type": "object",
        "required": [
          "hit",
          "layer"
        ],
        "title": "CacheInfo"
      },
      "ContinueRequest": {
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Cursor"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 6000.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 1000
          }
        },
        "type": "object",
        "required": [
          "cursor"
        ],
        "title": "ContinueRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GatewayResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "docs": {
            "type": "string",
            "title": "Docs"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "docs"
        ],
        "title": "GatewayResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MobileScrapeTextRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "include_nav": {
            "type": "boolean",
            "title": "Include Nav",
            "default": false
          },
          "include_header": {
            "type": "boolean",
            "title": "Include Header",
            "default": false
          },
          "include_footer": {
            "type": "boolean",
            "title": "Include Footer",
            "default": false
          },
          "render_js": {
            "type": "boolean",
            "title": "Render Js",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "MobileScrapeTextRequest"
      },
      "Provenance": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Identifier of the request."
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At",
            "description": "UTC ISO 8601 timestamp of the fetch."
          },
          "requested_url": {
            "type": "string",
            "title": "Requested Url",
            "description": "The requested URL with sensitive-looking query parameters removed."
          },
          "final_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Url",
            "description": "URL after redirects. Absent for cache hits."
          },
          "canonical_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Url",
            "description": "Canonical URL, if the page declares one."
          },
          "upstream_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Status",
            "description": "Upstream HTTP status. Absent for cache hits."
          },
          "redirect_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redirect Count",
            "description": "Redirects followed. Absent for cache hits."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "Content type of the fetched response."
          },
          "bytes_fetched": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bytes Fetched",
            "description": "Bytes fetched from the upstream source."
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Sha256",
            "description": "SHA-256 hash of the returned text."
          },
          "cache": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CacheInfo"
              },
