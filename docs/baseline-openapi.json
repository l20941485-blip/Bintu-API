            "default": "none"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "description": "True when the response came from the memory or persistent cache.",
            "default": false
          },
          "approx_tokens": {
            "type": "integer",
            "title": "Approx Tokens",
            "description": "Approximate token count of the returned text: ceil(characters / 4). An estimate, not a tokenizer count.",
            "default": 0
          },
          "token_method": {
            "type": "string",
            "title": "Token Method",
