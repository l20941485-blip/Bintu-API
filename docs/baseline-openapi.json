{
  "openapi": "3.1.0",
  "info": {
    "title": "Bintu Data Extraction API",
    "description": "Extract readable text from public HTML pages. JavaScript rendering is disabled unless explicitly enabled. Responses are bounded, requests are rate-limited, and outbound connections are validated against public IP addresses.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.4.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Gateway Check",
        "operationId": "gateway_check__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Version Info",
        "description": "Return service configuration (no secrets).",
        "operationId": "version_info_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scrape/text": {
      "get": {
        "summary": "Extract readable text from a public web page",
        "description": "Fetches a public HTML or XHTML page and returns readable text. The service prefers article or main content, formats headings and tables, and reports whether the configured text limit truncated the result. The service checks the site's robots.txt first. JavaScript rendering is disabled unless the service enables it.",
        "operationId": "scrape_text_api_v1_scrape_text_get",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Url"
            }
          },
          {
            "name": "include_nav",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Nav"
            }
          },
          {
            "name": "include_header",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Header"
            }
          },
          {
            "name": "include_footer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Footer"
            }
          },
          {
            "name": "render_js",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Render Js"
            }
          },
          {
            "name": "links",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "inline",
                "footnotes",
                "false"
              ],
              "type": "string",
              "default": "inline",
              "title": "Links"
            }
          },
          {
            "name": "footnote_url_policy",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "full",
                "truncated"
              ],
              "type": "string",
              "default": "truncated",
              "title": "Footnote Url Policy"
            }
          },
          {
            "name": "max_footnote_url_length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 100,
              "title": "Max Footnote Url Length"
            }
          },
          {
            "name": "skip_cache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Skip Cache"
            }
          },
          {
            "name": "persist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Persist"
            }
          },
          {
            "name": "max_tokens",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 6000,
              "title": "Max Tokens"
            }
          },
          {
            "name": "sections",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sections"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeTextResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scrape/chunks": {
      "post": {
        "summary": "Extract readable text as approximately token-budgeted chunks",
        "description": "Fetches a public HTML or XHTML page, extracts readable text, and returns fence-aware chunks sized to the requested token budget. The extraction character ceiling applies before chunking.",
        "operationId": "scrape_chunks_api_v1_scrape_chunks_post",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "max_tokens",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 6000,
              "title": "Max Tokens"
            }
          },
          {
            "name": "links",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "inline",
                "footnotes",
                "false"
              ],
              "type": "string",
              "default": "inline",
              "title": "Links"
            }
          },
          {
            "name": "skip_cache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Skip Cache"
            }
          },
          {
            "name": "persist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Persist"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileScrapeTextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeChunksResponse"
                }
              }
            }
          },
          "400": {
