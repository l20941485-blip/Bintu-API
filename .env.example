# Bintu Data Extraction API - environment template (safe to commit)
#
# Copy to .env and fill in real values; .env is git-ignored and docker-ignored.
#   Copy-Item .env.example .env
#
# Settings are read with os.getenv() only (bintu_api/settings.py), so export
# them in the shell first when running uvicorn or smoke_check.py directly:
#
#   Get-Content .env | Where-Object { $_ -and $_ -notmatch '^\s*#' } | ForEach-Object {
#     $name, $value = $_ -split '=', 2; Set-Item -Path "env:$name" -Value $value
#   }
#
# docker compose reads .env automatically for docker-compose.yml interpolation.

# --- Application runtime (bintu_api.settings.Settings.from_env) ------------
# Direct-caller secret, compared against the X-API-Key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Shared secret the RapidAPI gateway sends in X-RapidAPI-Proxy-Secret. Must be
# identical in this service and in the RapidAPI provider dashboard.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
RAPIDAPI_PROXY_SECRET=

# Cache TTL for successful scrapes, 0-86400 seconds; 0 disables the cache.
CACHE_TTL_SECONDS=300

# Optional. Empty = per-process burst guard. Set to share the rate-limit window
# across instances (redis:// for docker compose, rediss:// for Render Redis).
REDIS_URL=

# --- smoke_check.py -------------------------------------------------------
BINTU_BASE_URL=https://your-service.onrender.com
BINTU_API_KEY=
BINTU_SMOKE_TARGET_URL=https://example.com/

# --- Test credentials, not read by the application ------------------------
# RapidAPI consumer key (X-RapidAPI-Key) for calling the hosted storefront.
BINTU_RAPIDAPI_KEY=
# Render account API key for Render API/CLI deploys only.
RENDER_API_KEY=

# Uvicorn bind port (Render supplies its own via $PORT).
PORT=8000
